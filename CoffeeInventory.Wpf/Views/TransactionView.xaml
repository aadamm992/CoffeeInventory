<UserControl x:Class="CoffeeInventory.Wpf.Views.TransactionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:CoffeeInventory.Wpf.ViewModels"
             xmlns:behaviour="clr-namespace:CoffeeInventory.Wpf.Behaviours"
             d:DataContext="{d:DesignInstance Type=viewModels:TransactionViewModel}"
             mc:Ignorable="d"
             Background="#F0F0F0"
             d:DesignHeight="350"
             d:DesignWidth="700">

    <Grid Margin="3">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Row="0"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Margin="3"
                  Background="#F0F0F0"
                  RowBackground="#F0F0F0"
                  ItemsSource="{Binding TransactionRows}"
                  SelectedItem="{Binding SelectedTransactionRow}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  SelectionUnit="FullRow">

            <DataGrid.Resources>

                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="FontSize"
                            Value="15" />
                </Style>

                <Style TargetType="DataGridCell">
                    <Setter Property="HorizontalContentAlignment"
                            Value="Center" />
                    <Setter Property="VerticalContentAlignment"
                            Value="Center" />
                    <Setter Property="FontSize"
                            Value="14" />
                </Style>

            </DataGrid.Resources>

            <DataGrid.Columns>

                <!--Selection column-->
                <DataGridTemplateColumn Width="*"
                                        MaxWidth="35"
                                        MinWidth="35"
                                        CanUserSort="False">

                    <!--New printer add button-->
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <Grid>
                                <Button
                                    Command="{Binding DataContext.AddTransactionRowButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Right"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Focusable="False">
                                    <Image Source="/Resources/Images/Add.png"
                                           Width="16"
                                           Height="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>

                    <!--Remove printer button-->
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                Command="{Binding DataContext.RemoveTransactionRowButtonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                CommandParameter="{Binding}"
                                Width="20"
                                Height="20"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Focusable="False">
                                <Image Source="/Resources/Images/Trash.png"
                                       Width="16"
                                       Height="16" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

                <!--Transaction Type-->
                <DataGridTemplateColumn Header="TransactionType"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding TransactionTypes}"
                                      SelectedItem="{Binding SelectedTransactionType, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--Brand-->
                <DataGridTemplateColumn Header="Brand"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Brands}"
                                      SelectedItem="{Binding SelectedBrand, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--Name-->
                <DataGridTemplateColumn Header="Name"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Names}"
                                      SelectedItem="{Binding SelectedName, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--Quantity-->
                <DataGridTextColumn Header="Quantity"
                                    Width=".5*"
                                    Binding="{Binding SelectedQuantity, UpdateSourceTrigger=PropertyChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment"
                                    Value="Center" />
                            <Setter Property="VerticalAlignment"
                                    Value="Center" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="1"
                Grid.Column="2"
                Width="115"
                FontSize="16"
                Height="30"
                Margin="3"
                Content="_Clear"
                HorizontalAlignment="Left"
                ToolTip="Remove all transaction row"
                Command="{Binding ClearAllTransactionRowButtonCommand}" />

        <Button Grid.Row="1"
                Grid.Column="2"
                Content="_Submit"
                FontSize="16"
                HorizontalAlignment="Right"
                Width="115"
                Margin="3"
                Command="{Binding SubmitButtonCommand}" />

    </Grid>

</UserControl>