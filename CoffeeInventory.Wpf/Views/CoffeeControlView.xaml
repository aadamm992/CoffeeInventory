<UserControl x:Class="CoffeeInventory.Wpf.Views.CoffeeControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CoffeeInventory.Wpf.Views"
             xmlns:behaviours="clr-namespace:CoffeeInventory.Wpf.Behaviours"
             xmlns:viewModels="clr-namespace:CoffeeInventory.Wpf.ViewModels"
             d:DataContext="{d:DesignInstance Type=viewModels:CoffeeControlViewModel}"
             mc:Ignorable="d"
             Background="#F0F0F0"
             d:DesignHeight="310"
             d:DesignWidth="700">

    <UserControl.Resources>

        <Style x:Key="LabelStyle"
               TargetType="Label">
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="FontSize"
                    Value="16" />
        </Style>

        <Style x:Key="CheckBoxLabelStyle"
               TargetType="Label">
            <Setter Property="FontSize"
                    Value="12" />
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="Width"
                    Value="100" />
        </Style>

        <Style x:Key="TextBoxStyle"
               TargetType="TextBox">
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Height"
                    Value="25" />
            <Setter Property="FontSize"
                    Value="16" />
        </Style>

    </UserControl.Resources>

    <local:EntityControlViewBase EntityItemSource="{Binding CoffeesView}"
                                 SelectedEntity="{Binding SelectedCoffee}"
                                 EntityDisplayMemberPath="Name"
                                 UpdateCommand="{Binding UpdateCommand}"
                                 SaveAsNewCommand="{Binding SaveAsNewCommand}"
                                 DeleteCommand="{Binding DeleteCommand}">

        <local:EntityControlViewBase.EditorContent>

            <Grid Margin="20">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--Brand Label and TextBox-->
                <Label Grid.Row="0"
                       Grid.Column="0"
                       Content="Brand"
                       Style="{StaticResource LabelStyle}" />

                <ComboBox Grid.Row="0"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Margin="0,0,0,10"
                          FontSize="14"
                          HorizontalAlignment="Left"
                          Width="200"
                          Height="25"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding Brands}"
                          SelectedItem="{Binding SelectedBrand}"
                          DisplayMemberPath="Name"
                          d:SelectedIndex="0" />

                <!--Name Label and TextBox-->
                <Label Grid.Row="2"
                       Grid.Column="0"
                       Content="Name"
                       Style="{StaticResource LabelStyle}" />

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         d:Text="Kazaar"
                         HorizontalAlignment="Left"
                         Width="200"
                         FontSize="14"
                         Style="{StaticResource TextBoxStyle}"
                         Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--Is Decaffeinated Label and TextBox-->
                <Label Grid.Row="6"
                       Grid.Column="0"
                       Margin="0,0,0,10"
                       Content="Is Decaffeinated"
                       Style="{StaticResource LabelStyle}" />

                <CheckBox Grid.Row="6"
                          Grid.Column="1"
                          d:IsChecked="True"
                          Margin="0,0,0,10"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsDecaffeinated}" />

                <!--Capsule Types Label and ComboBox-->
                <Label Grid.Row="7"
                       Grid.Column="0"
                       Margin="0,0,0,10"
                       Content="Capsule Type"
                       Style="{StaticResource LabelStyle}" />

                <ComboBox Grid.Row="7"
                          Grid.Column="1"
                          Grid.ColumnSpan="3"
                          Margin="0,0,0,10"
                          FontSize="14"
                          HorizontalAlignment="Left"
                          Width="200"
                          Height="25"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center"
                          ItemsSource="{Binding CapsuleTypes}"
                          SelectedItem="{Binding SelectedCapsuleType}"
                          DisplayMemberPath="Name"
                          d:SelectedIndex="0" />

                <!--Cup Sizes labels and checkboxes-->
                <Label Grid.Row="8"
                       Grid.RowSpan="2"
                       Grid.Column="0"
                       Style="{StaticResource LabelStyle}"
                       Content="Cup Sizes" />

                <!--Ristretto Label and CheckBox-->
                <Label Grid.Row="8"
                       Grid.Column="1"
                       Margin="0,0,0,10"
                       Content="Ristretto (25 ml)"
                       Style="{StaticResource CheckBoxLabelStyle}" />

                <CheckBox Grid.Row="9"
                          Grid.Column="1"
                          d:IsChecked="True"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsRistretto}" />

                <!--Espresso Label and CheckBox-->
                <Label Grid.Row="8"
                       Grid.Column="2"
                       Content="Espresso (40 ml)"
                       Style="{StaticResource CheckBoxLabelStyle}" />

                <CheckBox Grid.Row="9"
                          Grid.Column="2"
                          Margin="0,0,0,10"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsEspresso}" />

                <!--Lungo Label and CheckBox-->
                <Label Grid.Row="8"
                       Grid.Column="3"
                       Content="Lungo (110 ml)"
                       Style="{StaticResource CheckBoxLabelStyle}" />

                <CheckBox Grid.Row="9"
                          Grid.Column="3"
                          Margin="0,0,0,10"
                          d:IsChecked="True"
                          HorizontalAlignment="Center"
                          IsChecked="{Binding IsLungo}" />

            </Grid>

        </local:EntityControlViewBase.EditorContent>

    </local:EntityControlViewBase>

</UserControl>
