<Application x:Class="CoffeeInventory.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CoffeeInventory.Wpf"
             xmlns:viewModels="clr-namespace:CoffeeInventory.Wpf.ViewModels"
             xmlns:views="clr-namespace:CoffeeInventory.Wpf.Views">

    <Application.Resources>

        <DataTemplate DataType="{x:Type viewModels:TransactionViewModel}">
            <views:TransactionView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModels:InventoryViewModel}">
            <views:InventoryView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:ControlsViewModel}">
            <views:ControlsView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:BrandControlViewModel}">
            <views:BrandControlView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:CoffeeControlViewModel}">
            <views:CoffeeControlView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:CapsuleTypeControlViewModel}">
            <views:CapsuleTypeControlView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type viewModels:CupSizeControlViewModel}">
            <views:CupSizeControlView />
        </DataTemplate>

    </Application.Resources>

</Application>
