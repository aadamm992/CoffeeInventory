<Window x:Class="CoffeeInventory.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:CoffeeInventory.Wpf.ViewModels"
        xmlns:converters="clr-namespace:CoffeeInventory.Wpf.Converters"
        xmlns:views="clr-namespace:CoffeeInventory.Wpf.Views"
        d:DataContext="{d:DesignInstance Type=viewModels:MainViewModel}"
        mc:Ignorable="d"
        Background="#F0F0F0"
        Title="Nespresso Inventory"
        Icon="Resources/NespressoIcon.ico"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Height="550"
        Width="850">

    <Window.Resources>
        <converters:NotificationColorConverter x:Key="NotificationColorConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <views:MenuBarView DataContext="{Binding MenuBarViewModel}"
                           DockPanel.Dock="Top" />

        <StatusBar DockPanel.Dock="Bottom"
                   Background="White"
                   Height="30">

            <StatusBarItem>

                <TextBlock Foreground="{Binding NotificationViewModel.Type, Converter={StaticResource NotificationColorConverter}}"
                           FontWeight="Medium"
                           Padding="5,0,0,0"
                           d:Foreground="DodgerBlue"
                           d:Text="2026.07.19 11:38 | Add new Coffee successfull"
                           Text="{Binding NotificationViewModel.Message}"
                           Visibility="{Binding NotificationViewModel.Message, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"
                           HorizontalAlignment="Stretch" />

            </StatusBarItem>

        </StatusBar>

        <TabControl x:Name="MainTabControl"
                    Grid.Row="1">

            <TabControl.Resources>

                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="White"
                                        BorderBrush="#AAA"
                                        BorderThickness="1,1,1,0"
                                        CornerRadius="3,3,0,0"
                                        Padding="0,3">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center" />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter TargetName="Border"
                                                Property="Background"
                                                Value="#F0F0F0" />
                                        <Setter Property="Foreground"
                                                Value="Black" />
                                        <Setter Property="FontWeight"
                                                Value="Bold" />
                                    </Trigger>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Border"
                                                Property="Background"
                                                Value="#BEE3FF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <UniformGrid IsItemsHost="True"
                                     Grid.Row="0"
                                     Rows="1"
                                     Columns="{Binding Path=Items.Count, RelativeSource={RelativeSource AncestorType=TabControl}}" />

                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent" />

                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <!--Transaction View TabItem-->
            <TabItem Header="Transactions"
                     FontSize="18"
                     Content="{Binding TransactionViewModel}">
            </TabItem>

            <!--Inventory View TabItem-->
            <TabItem Header="Inventory"
                     FontSize="18"
                     Content="{Binding InventoryViewModel}">
            </TabItem>

            <!--Controls View TabItem-->
            <TabItem Header="Controls"
                     FontSize="18"
                     Content="{Binding ControlsViewModel }">
            </TabItem>

        </TabControl>

    </DockPanel>

</Window>